module control_results
contains
function extent(n) result(value)
integer,intent(in)::n
integer,allocatable::value
allocate(value,source=n)
end function
end module
program allocation_values
use control_results
integer,allocatable::a(:)
integer::status(3)
character(len=20)::message(3)
status=-99
if(.true.) allocate(a(extent(3)),source=7,stat=status(extent(2)),errmsg=message(extent(2)))
deallocate(a,stat=status(extent(2)),errmsg=message(2)(extent(2):10))
end program
